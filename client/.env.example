# Leave empty to use the same-origin /api and /uploads routes in development and on Vercel.
# Set only when the API is deployed to a separate origin.
VITE_API_URL=

# Public sign-in (optional). The matching buttons appear on /login only when set.
# Google: OAuth 2.0 Client ID (must match the server's GOOGLE_CLIENT_ID audience).
# VITE_GOOGLE_CLIENT_ID=
# Apple: Services ID (must match the server's APPLE_CLIENT_ID audience).
# VITE_APPLE_CLIENT_ID=
