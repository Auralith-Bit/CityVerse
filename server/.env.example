# Server
PORT=5000
NODE_ENV=development

# MySQL (MySQL Workbench connection)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:password@127.0.0.1:3306/cityverse"

# Auth
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="1d"

# Public sign-in (optional). Without these, /api/auth/google and /api/auth/apple return 503.
# Google: OAuth 2.0 Client ID from Google Cloud Console (Web application).
GOOGLE_CLIENT_ID=""
# Apple: Services ID from your Apple Developer account (Sign in with Apple).
APPLE_CLIENT_ID=""

# CORS
# Set to the frontend origin. For Vercel services on one domain, use that deployment's origin.
# Separate multiple allowed origins with commas.
CLIENT_ORIGIN="http://localhost:5173"

# Seeded admin account (used by `npm run seed`)
ADMIN_NAME="CityVerse Admin"
ADMIN_EMAIL="admin@cityverse.com"
ADMIN_PASSWORD="admin123"
