# Server
PORT=5000
NODE_ENV=development

# MySQL (MySQL Workbench connection)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:password@127.0.0.1:3306/cityverse"

# Auth
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="1d"

# CORS
CLIENT_ORIGIN="http://localhost:5173"

# Seeded admin account (used by `npm run seed`)
ADMIN_NAME="CityVerse Admin"
ADMIN_EMAIL="admin@cityverse.com"
ADMIN_PASSWORD="admin123"
